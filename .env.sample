# Base URL of the backend as seen from the device. 10.0.2.2 is the Android
# emulator's alias for the host machine; use your LAN IP for a physical device.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:9000

# OpenObserve RUM (optional — leave the token/endpoint unset and the SDK never
# initialises). The client token comes from OpenObserve → Ingestion → RUM: it
# is write-only for RUM data and designed to ship inside client apps, the same
# class of credential as the web's RUM client token. It needs a
# development/EAS build, not Expo Go (native module, not usable in Expo Go).
# EXPO_PUBLIC_OPENOBSERVE_RUM_CLIENT_TOKEN=
# EXPO_PUBLIC_OPENOBSERVE_RUM_ENDPOINT=http://10.0.2.2:55080
# EXPO_PUBLIC_OPENOBSERVE_RUM_APPLICATION_ID=madrileno-mobile
# EXPO_PUBLIC_OPENOBSERVE_RUM_ENV=development

# Universal / App Links (optional). When set, app.config.ts adds the iOS
# associated domain and the Android autoVerify intent filter for this host.
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=app.example.com

# EAS project binding (optional, build-time only — not EXPO_PUBLIC_, no secret).
# Unset, the template ships with no EAS project bound to it.
# EAS_OWNER=your-eas-account
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
